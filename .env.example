# If your machine does not already run PostgreSQL on port 5432, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb
#
# If port 5432 is already used by another PostgreSQL, map Docker to 5433
# in docker-compose.yml and use:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ragdb

OLLAMA_BASE_URL=http://localhost:11434

# Good default for most local machines.
OLLAMA_LLM_MODEL=qwen2.5:3b

# Required embedding model for this project.
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
